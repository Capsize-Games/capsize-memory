#!/bin/sh
### BEGIN INIT INFO
# Provides:          gh-runner-capsize-memory-ci
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: GitHub Actions runner (capsize-memory-ci)
### END INIT INFO
RUNNER_DIR="/home/joe/actions-runner/capsize-memory-ci"
RUNNER_USER="joe"
PIDFILE="/var/run/gh-runner-capsize-memory-ci.pid"
LOGFILE="/home/joe/actions-runner/capsize-memory-ci/runner.log"
PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

case "$1" in
  start)
    echo "Starting gh-runner-capsize-memory-ci"
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
      --chuid "$RUNNER_USER" --chdir "$RUNNER_DIR" \
      --exec /bin/bash -- -c "./run.sh >> $LOGFILE 2>&1"
    ;;
  stop)
    echo "Stopping gh-runner-capsize-memory-ci"
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry 30
    rm -f "$PIDFILE"
    ;;
  status)
    start-stop-daemon --status --pidfile "$PIDFILE" && echo "running" || echo "stopped"
    ;;
  restart) $0 stop; $0 start ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
